<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tasto del pad direzionale: cerchio scuro con icona centrata. -->
    <style name="Widget.IcaroManager.PadButton" parent="">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_pad_button</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Comando della barra inferiore: icona sopra, etichetta sotto. -->
    <style name="Widget.IcaroManager.BarButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Comando di trasporto del player: come il tasto del pad, un po' più piccolo per stare in
         cinque su una riga anche sui telefoni da 360 dp. -->
    <style name="Widget.IcaroManager.PlayerButton" parent="Widget.IcaroManager.PadButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Tasti del volume: più compatti del trasporto, lasciano spazio al cursore. -->
    <style name="Widget.IcaroManager.VolumeButton" parent="Widget.IcaroManager.PadButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
