<?xml version="1.0" encoding="utf-8"?>
<!-- Schermata del telecomando: stato del collegamento, ricerca, percorso, elenco speculare a
     quello della TV, pad direzionale a scomparsa e barra dei comandi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <!-- Fascia di stato: visibile solo se non collegato; toccandola si sceglie la TV. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/banner_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Ricerca della TV nella rete Wi-Fi…" />

            <TextView
                android:id="@+id/banner_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/conn_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Due schermate nello stesso spazio: file manager (specchio della TV) e telecomando del
         player. Si passa dall'una all'altra senza toccare la riproduzione sulla TV. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/browser_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Ricerca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLength="200"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/search_clear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_clear"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <CheckBox
                android:id="@+id/recursive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/search_recursive"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/searching"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="24 risultati" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/crumbs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/crumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Impossibile leggere /storage/1234-5678"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:singleLine="true"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="In riproduzione: Film.mkv"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="Cartella vuota" />
        </FrameLayout>

        <!-- Mini-barra del player: visibile nel file manager mentre la TV riproduce; toccandola si
             torna alla schermata del player, il pulsante a destra mette in pausa senza cambiare vista. -->
        <LinearLayout
            android:id="@+id/now_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_now_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/now_bar_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_movie" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/now_bar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="Episodio 02.mkv" />

                <TextView
                    android:id="@+id/now_bar_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/now_bar_open"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/now_bar_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:max="1000"
                    android:progressTint="@color/accent"
                    tools:progress="400" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/now_bar_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play_pause"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/now_bar_open"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/now_bar_open"
                android:src="@drawable/ic_pad_up" />
        </LinearLayout>

        <!-- Pad direzionale a scomparsa: comanda la TV come il suo telecomando. -->
        <include
            android:id="@+id/pad"
            layout="@layout/view_pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Barra dei comandi sempre visibile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cmd_root"
                style="@style/Widget.IcaroManager.BarButton"
                android:drawableTop="@drawable/ic_home"
                android:text="@string/cmd_root" />

            <Button
                android:id="@+id/cmd_up"
                style="@style/Widget.IcaroManager.BarButton"
                android:drawableTop="@drawable/ic_arrow_up"
                android:text="@string/cmd_up" />

            <Button
                android:id="@+id/cmd_pad"
                style="@style/Widget.IcaroManager.BarButton"
                android:drawableTop="@drawable/ic_tv"
                android:text="@string/cmd_pad" />

            <Button
                android:id="@+id/cmd_refresh"
                style="@style/Widget.IcaroManager.BarButton"
                android:drawableTop="@drawable/ic_refresh"
                android:text="@string/cmd_refresh" />
        </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/player_screen"
            layout="@layout/screen_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
