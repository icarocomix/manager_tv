<?xml version="1.0" encoding="utf-8"?>
<!-- Schermata principale della TV: pannello di stato e azioni a sinistra, file manager a destra.
     I margini esterni rispettano l'area sicura per l'overscan dei televisori (5%). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<!-- File manager (sotto) e player integrato (sopra): lo stesso player passa da schermo intero a
     miniatura cambiando solo dimensioni del contenitore, senza ricaricare il video. -->
<LinearLayout
    android:id="@+id/browser"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp">

    <!-- ============================================================ pannello sinistro -->
    <ScrollView
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo_app" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stato della connessione con lo smartphone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_search"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="In attesa dello smartphone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="8dp"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="192.168.1.20 : 47810" />

                <TextView
                    android:id="@+id/now_playing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="In riproduzione: Film.mkv"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Azioni -->
            <!-- Visibili solo con un file nel player integrato. -->
            <Button
                android:id="@+id/btn_back_to_player"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:layout_marginTop="18dp"
                android:drawableStart="@drawable/ic_fullscreen"
                android:text="@string/btn_back_to_player"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btn_close_player"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_stop"
                android:text="@string/btn_close_player"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btn_root"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:layout_marginTop="18dp"
                android:drawableStart="@drawable/ic_home"
                android:text="@string/btn_root" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_refresh"
                android:text="@string/btn_refresh" />

            <Button
                android:id="@+id/btn_add_saf"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_folder_open"
                android:text="@string/btn_add_saf" />

            <Button
                android:id="@+id/btn_permissions"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_shield"
                android:text="@string/btn_permissions" />

            <Button
                android:id="@+id/btn_overlay"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_tune"
                android:text="@string/btn_overlay" />

            <Button
                android:id="@+id/btn_export_logs"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_bug_report"
                android:text="@string/btn_export_logs" />

            <Button
                android:id="@+id/btn_credits"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_info"
                android:text="@string/credits_title" />

            <Button
                android:id="@+id/btn_power"
                style="@style/Widget.IcaroManager.Tv.PanelButton"
                android:drawableStart="@drawable/ic_power"
                android:text="@string/btn_power" />
        </LinearLayout>
    </ScrollView>

    <!-- ============================================================ file manager -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:maxLength="200"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/recursive"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_focus_item"
                android:paddingStart="6dp"
                android:paddingEnd="12dp"
                android:text="@string/search_recursive"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Percorso corrente: ogni elemento è selezionabile per risalire a quel livello. -->
        <HorizontalScrollView
            android:id="@+id/crumbs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/crumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="Impossibile leggere /storage/1234-5678"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:visibility="gone"
                tools:text="Cartella vuota" />

            <ProgressBar
                android:id="@+id/searching"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

<!-- Player integrato. In miniatura: angolo in basso a destra, dentro l'area sicura per
     l'overscan, cornice d'accento quando ha il focus; dimensioni impostate dal codice. -->
<FrameLayout
    android:id="@+id/player_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:foreground="@drawable/bg_mini_player"
    android:visibility="gone">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:show_shuffle_button="false"
        app:show_subtitle_button="true"
        app:surface_type="surface_view" />

    <TextView
        android:id="@+id/mini_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:ellipsize="middle"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Film.mkv · OK: schermo intero" />
</FrameLayout>

<!-- Domanda di ripresa: comune a schermo intero e miniatura. Risponde il primo tra TV e
     telefono; senza risposta la TV riprende da sola. -->
<LinearLayout
    android:id="@+id/resume_panel"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_resume_panel"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="28dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resume_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resume_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        tools:text="«Film.mkv» era stato interrotto a 1:02:03." />

    <TextView
        android:id="@+id/resume_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/accent"
        android:textSize="14sp"
        tools:text="Ripresa automatica tra 12 s" />

    <Button
        android:id="@+id/resume_yes"
        style="@style/Widget.IcaroManager.Tv.PanelButton"
        android:layout_marginTop="18dp"
        android:drawableStart="@drawable/ic_play"
        tools:text="Riprendi da 1:02:03" />

    <Button
        android:id="@+id/resume_no"
        style="@style/Widget.IcaroManager.Tv.PanelButton"
        android:drawableStart="@drawable/ic_seek_start"
        android:text="@string/resume_restart" />
</LinearLayout>
</FrameLayout>
