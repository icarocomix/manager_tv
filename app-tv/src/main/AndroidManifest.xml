<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Server HTTP/WebSocket per il telefono, annuncio NSD e beacon UDP in rete locale. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Ricezione delle sonde UDP in broadcast dal telefono: alcuni driver Wi-Fi le scartano senza lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Server attivo anche con il player esterno in primo piano: servizio in primo piano. -->
    <!-- Wake lock della CPU durante la riproduzione (ExoPlayer WAKE_MODE_LOCAL). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Riavvio del server all'accensione della TV, così il telefono può aprire l'app da remoto. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lettura dei dischi USB. Fino ad Android 12 basta READ_EXTERNAL_STORAGE; da Android 13 i
         permessi per tipo di media consentono di vedere cartelle e file multimediali; l'accesso
         completo a tutti i file (anche non multimediali) richiede MANAGE_EXTERNAL_STORAGE. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Fino ad Android 10: scrittura sui dischi (operazioni sui file e ricezione dal telefono,
         v1.9) e salvataggio dei log in Download. Su Android 10 vale con requestLegacyExternalStorage;
         da Android 11 serve l'accesso a tutti i file (MANAGE_EXTERNAL_STORAGE). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Avvio del player su comando del telefono mentre un'altra app è in primo piano: Android 10+
         lo consente solo alle app con il permesso di sovrapposizione concesso. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- App pensata per la TV: Leanback richiesto, touchscreen no (si usa il telecomando). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Da Android 11 le app installate sono visibili solo se dichiarate: servono per sapere se
         esiste un player per il tipo di file e per ripiegare sul tipo generico. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".TvApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IcaroManager.Tv"
        tools:targetApi="36">

        <activity
            android:name=".ui.TvMainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Avvio anche dal launcher classico (box Android non certificati Android TV). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Apertura dal telefono tramite il servizio di controllo remoto di Android TV
                 (Protocol.TV_APP_LINK): funziona anche con l'app mai avviata o appena
                 riaccesa la TV, quando il server dell'app non è ancora in ascolto. Il link
                 apre soltanto l'interfaccia, senza parametri. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="open"
                    android:scheme="icaromanagertv" />
            </intent-filter>
        </activity>

        <!-- Possiede server, annuncio in rete e stato del file manager: resta attivo mentre il
             player esterno è in primo piano, così il telefono continua a controllare la TV. -->
        <service
            android:name=".service.RemoteServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Server di rete locale per il telecomando dello smartphone (file manager e avvio del player)" />
        </service>

        <!-- Riavvia il server all'accensione e dopo gli aggiornamenti, se l'utente non l'aveva
             spento (vedi BootReceiver). -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- URI content:// per passare i file dei dischi USB ai player esterni (file:// è vietato
             da Android 7). Il percorso radice copre qualunque punto di montaggio /storage/XXXX. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
