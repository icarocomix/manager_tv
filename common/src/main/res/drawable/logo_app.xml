<?xml version="1.0" encoding="utf-8"?>
<!-- Logo dell'app nel dialog Info e nell'intestazione TV: stesso simbolo dell'icona su fondo arrotondato. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/icon_bg_end"
                android:startColor="@color/icon_bg_start" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
