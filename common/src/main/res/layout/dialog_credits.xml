<?xml version="1.0" encoding="utf-8"?>
<!-- Contenuto del dialog "Info / Crediti" (stesso schema di IcaroTube): logo e nome dell'app,
     versione, "Applicazione creata da" con il logo aziendale e il nome dell'autore, descrizione
     e librerie. Nome, versione, descrizione e librerie li imposta CreditsDialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_manager_tv" />

        <TextView
            android:id="@+id/credits_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Manager TV" />

        <TextView
            android:id="@+id/credits_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Versione 1.0.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/credits_created_by"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Logo aziendale su targa chiara, tra "Applicazione creata da" e il nome dell'autore. -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_company_logo"
            android:contentDescription="@string/credits_company_logo"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_azienda" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/credits_author"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/credits_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/credits_libraries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
